---
const {title} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />

		<footer>
			<p>Made by: <a href="https://github.com/barrientosvctor">Victor Barrientos</a></p>
		</footer>
	</body>
</html>

<style>
	* {
        margin: 0;
        padding: 0;
    }

	html,
	body {
		width: 100%;
		height: 100%;
	}

	footer {
		padding: 10px;
		text-align: center;
	}
</style>
