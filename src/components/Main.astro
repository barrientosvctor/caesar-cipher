---
import CaesarCipher from "./CaesarCipher.astro";
---

<main>
	<header class="h-options">
		<ul>
			<li>
				<a href="/manual">User Manual</a>
			</li>
			<li>
				<a href="https://github.com/barrientosvctor" target="_blank">GitHub</a>
			</li>
		</ul>
	</header>

	<div class="caesar">
		<CaesarCipher />
	</div>
</main>

<style>
	* {
        margin: 0;
        padding: 0;
    }

	.h-options {
		display: flex;
		flex-direction: row;
		justify-self: center;
		justify-items: center;
	}

	.caesar {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		margin: 10dvh 0;
	}
</style>