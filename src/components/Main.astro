---
import CaesarCipher from "./CaesarCipher.astro";
---

<main id="main-content" class="flex flex-1 flex-col">
	<header class="mx-auto w-full max-w-6xl px-6 py-6">
		<nav aria-label="Primary navigation">
			<ul class="flex items-center justify-between text-sm font-medium text-slate-300">
				<li>
					<a
						href="/TechnicalReport.pdf"
						target="_blank"
						rel="external"
						class="transition hover:text-white"
					>Technical Report</a>
				</li>
				<li>
					<a href="/manual" class="transition hover:text-white">User Manual</a>
				</li>
				<li>
					<a
						href="https://github.com/barrientosvctor/caesar-cipher"
						target="_blank"
						rel="noopener noreferrer"
						class="transition hover:text-white"
					>
						Source Code
					</a>
				</li>
			</ul>
		</nav>
	</header>

	<section class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-6 py-10 sm:py-16" aria-labelledby="page-title">
		<div class="mb-10 space-y-2 text-center">
			<h1 id="page-title" class="text-3xl font-semibold tracking-tight text-slate-100 sm:text-4xl">
				Caesar Cipher
			</h1>
			<p class="mx-auto max-w-md text-sm text-slate-400">
				Encrypt and decrypt messages in English or Spanish.
			</p>
		</div>

		<CaesarCipher />
	</section>
</main>