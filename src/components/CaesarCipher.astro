---
import * as constantText from "../constants/text";
---

<div id="cipher-card" class="mx-auto w-full max-w-2xl rounded-3xl border border-white/10 bg-white/5 shadow-xl shadow-slate-950/50 sm:p-10 p-6">
	<div class="mb-8 grid gap-6 sm:grid-cols-2">
		<fieldset>
			<legend class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-400">
				Action
			</legend>
			<div class="inline-flex w-full rounded-xl border border-white/10 bg-black/20 p-1">
				<button
					id="encrypt-btn"
					class="mode-btn flex-1 rounded-lg bg-indigo-500/30 px-4 py-2 m-0.5 text-sm font-medium text-white transition-colors"
					data-action-text={constantText.CIPHER_ACTION_TEXT}
				>
					{constantText.CIPHER_ACTION_TEXT}
				</button>
				<button
					id="decrypt-btn"
					class="mode-btn flex-1 rounded-lg bg-white/5 px-4 py-2 m-0.5 text-sm font-medium text-slate-300 transition-colors hover:text-white"
					data-action-text={constantText.DECIPHER_ACTION_TEXT}
				>
					{constantText.DECIPHER_ACTION_TEXT}
				</button>
			</div>
		</fieldset>

		<fieldset>
			<legend class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-400">
				Alphabet
			</legend>
			<div class="inline-flex w-full rounded-xl border border-white/10 bg-black/20 p-1">
				<button
					id="english-btn"
					class="lang-btn flex-1 rounded-lg bg-indigo-500/30 px-4 py-2 m-0.5 text-sm font-medium text-white transition-colors"
					data-language={constantText.ENGLISH_LANGUAGE_TEXT}
				>
					{constantText.ENGLISH_LANGUAGE_TEXT}
				</button>
				<button
					id="spanish-btn"
					class="lang-btn flex-1 rounded-lg bg-white/5 px-4 py-2 m-0.5 text-sm font-medium text-slate-300 transition-colors hover:text-white"
					data-language={constantText.SPANISH_LANGUAGE_TEXT}
				>
					{constantText.SPANISH_LANGUAGE_TEXT}
				</button>
			</div>
		</fieldset>
	</div>

	<div class="mb-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 rounded-xl border border-white/10 bg-black/20 px-10 py-3 text-sm">
		<p>
			<span class="font-semibold text-slate-200">Action mode: </span>
			<span id="summary-action" class="text-indigo-300">{constantText.CIPHER_ACTION_TEXT}</span>
		</p>
		<p>
			<span class="font-semibold text-slate-200">Language selected: </span>
			<span id="summary-language" class="text-indigo-300">{constantText.ENGLISH_LANGUAGE_TEXT}</span>
		</p>
	</div>

	<form class="f-interaction space-y-5" action="">
		<div class="grid gap-5 sm:grid-cols-3">
			<div class="sm:col-span-2">
				<label for="normal-text" class="mb-2 block text-sm font-medium text-slate-300">
					Text to <span id="label-selected-action">{constantText.CIPHER_ACTION_TEXT.toLowerCase()}</span>
				</label>
				<input
					type="text"
					name="normal-text"
					id="normal-text"
					placeholder="Write your message here..."
					class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white transition outline-none placeholder:text-slate-500 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/40"
					required
				/>
			</div>

			<div>
				<label for="shift" class="mb-2 block text-sm font-medium text-slate-300">
					Shift (3 - 7)
				</label>
				<input
					type="number"
					name="shift"
					id="shift"
					value="3"
					min="3"
					max="7"
					class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white transition outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/40"
					required
				/>
			</div>
		</div>

		<button
			type="submit"
			id="send-btn"
			class="w-full rounded-xl bg-indigo-500 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-300 hover:shadow-amber-300/20 hover:shadow-xl/50"
		>
			{constantText.CIPHER_ACTION_TEXT}
		</button>
	</form>

	<div class="mt-6">
		<label id="label-result" for="ciphered-text" class="mb-2 block text-sm font-medium text-slate-300" data-label-cipher={constantText.CIPHER_LABEL_TEXT} data-label-decipher={constantText.DECIPHER_LABEL_TEXT}>
			{constantText.CIPHER_LABEL_TEXT}
		</label>
		<output
			id="ciphered-text"
			class="block min-h-24 w-full rounded-2xl border border-dashed border-white/15 bg-black/30 p-4 wrap-break-word text-lg text-emerald-300"
		></output>
		<button
			id="copy-btn"
			type="button"
			class="mt-3 hidden items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:border-white/20 hover:text-white"
			data-label={constantText.COPY_BUTTON_TEXT}
		>
			{constantText.COPY_BUTTON_TEXT}
		</button>
	</div>
</div>

<script>
	import { Caesar } from "../classes/Caesar";

	const encryptBtn = document.getElementById("encrypt-btn");
	const decryptBtn = document.getElementById("decrypt-btn");
	const englishBtn = document.getElementById("english-btn");
	const spanishBtn = document.getElementById("spanish-btn");
	const sendBtn = document.getElementById("send-btn");
	const form = document.querySelector(".f-interaction");
	const textInput = document.getElementById("normal-text") as HTMLInputElement;
	const shiftInput = document.getElementById("shift") as HTMLInputElement;
	const output = document.getElementById("ciphered-text");
	const textSummaryAction = document.getElementById("summary-action");
	const textSummaryLanguage = document.getElementById("summary-language");
	const copyBtn = document.getElementById("copy-btn");
	const resultLabel = document.getElementById("label-result") as HTMLLabelElement;
	const selectedActionLabel = document.getElementById("label-selected-action") as HTMLSpanElement;

	let copyButtonShown = false;

	const activeClasses = ["bg-indigo-500/30", "text-white"];
	const inactiveClasses = ["bg-white/5", "text-slate-300", "hover:text-white"];
	const normalButtonClasses = ["border-white/10", "bg-white/5"];
	const successButtonClasses = ["border-green-400/75", "bg-green-900/75"];
	const errorButtonClasses = ["border-red-400/75", "bg-red-900/40"];

	const setActiveButton = (buttons: HTMLElement[], activeButton: HTMLElement) => {
		buttons.forEach((button) => {
			if (button === activeButton) {
				button.classList.remove(...inactiveClasses);
				button.classList.add(...activeClasses);
			} else {
				button.classList.remove(...activeClasses);
				button.classList.add(...inactiveClasses);
			}
		});
	}

	if (encryptBtn && decryptBtn && sendBtn && textSummaryAction && resultLabel && selectedActionLabel) {
		encryptBtn.addEventListener("click", () => {
			Caesar.setEncryptMode();
			setActiveButton([encryptBtn, decryptBtn], encryptBtn);
			textSummaryAction.textContent = encryptBtn.dataset.actionText!;
			sendBtn.textContent = encryptBtn.dataset.actionText!;
			selectedActionLabel.textContent = encryptBtn.dataset.actionText!.toLowerCase();
			resultLabel.textContent = resultLabel.dataset.labelCipher!;
		});
		
		decryptBtn.addEventListener("click", () => {
			Caesar.setDecryptMode();
			setActiveButton([encryptBtn, decryptBtn], decryptBtn);
			textSummaryAction.textContent = decryptBtn.dataset.actionText!;
			sendBtn.textContent = decryptBtn.dataset.actionText!;
			selectedActionLabel.textContent = decryptBtn.dataset.actionText!.toLowerCase();
			resultLabel.textContent = resultLabel.dataset.labelDecipher!;
		});
	}

	if (englishBtn && spanishBtn && textSummaryLanguage) {
		englishBtn.addEventListener("click", () => {
			Caesar.setEnglishAlphabet();
			setActiveButton([englishBtn, spanishBtn], englishBtn);
			textSummaryLanguage.textContent = englishBtn.dataset.language!;
		});

		spanishBtn.addEventListener("click", () => {
			Caesar.setSpanishAlphabet();
			setActiveButton([englishBtn, spanishBtn], spanishBtn);
			textSummaryLanguage.textContent = spanishBtn.dataset.language!;
		});
	}

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const shift = Number(shiftInput?.value) || 0;

		if (output) {
			output.textContent = Caesar.cipher(textInput.value, shift);

			if (!copyButtonShown && textInput.value.trim() !== "" && output.textContent.trim() !== "") {
				copyBtn?.classList.remove("hidden");
				copyBtn?.classList.add("inline-flex");
				copyButtonShown = true;
			}
		}
	});

	if (copyBtn) {
		copyBtn.addEventListener("click", async () => {
			if (output) {
				let success = false;
				copyBtn.classList.remove(...normalButtonClasses);
				try {
					await navigator.clipboard.writeText(output.textContent);
					copyBtn.classList.add(...successButtonClasses);
					copyBtn.textContent = "Copied!";
					success = true;
				} catch (err) {
					copyBtn.classList.add(...errorButtonClasses);
					copyBtn.textContent = "Not copied!";
				} finally {
					setTimeout(() => {
						copyBtn.textContent = copyBtn.dataset.label!;
						if (success) {
							copyBtn.classList.remove(...successButtonClasses);
						} else {
							copyBtn.classList.remove(...errorButtonClasses);
						}
						copyBtn.classList.add(...normalButtonClasses);
					}, 1500);
				}
			}
		});
	}
</script>